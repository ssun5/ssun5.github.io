{
  "name": "testbench_postcss",
  "version": "1.0.0",
  "description": "Portfolio website built with Eleventy, PostCSS, and Tailwind CSS",
  "main": "index.js",
  "scripts": {
    "build:postcss": "postcss input.css -o public/output.css",
    "build:postcss:prod": "NODE_ENV=production postcss input.css -o public/output.css",
    "build:11ty": "NODE_ENV=production eleventy",
    "dev:postcss": "postcss input.css -o public/output.css --watch",
    "dev:11ty": "eleventy --serve",
    "build": "npm-run-all build:postcss:prod build:11ty",
    "dev": "npm-run-all -p dev:postcss dev:11ty",
    "start": "npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/postcss": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "cssnano": "^7.1.7",
    "eleventy-plugin-mathjax": "^2.0.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.12",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.2.4"
  },
  "dependencies": {
    "dayjs": "^1.11.20"
  }
}
