<!-- src/_includes/base.njk -->
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }}</title>
    <script src="https://kit.fontawesome.com/f94f6790a2.js" crossorigin="anonymous"></script>
	<link href="/output.css" rel="stylesheet">

    <!-- MathJax Client-Side Loader -->
    <script>
      MathJax = {
        tex: {
          packages: ['base', 'ams'],
          inlineMath: [['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']],
          processEscapes: true,
          processEnvironments: true,
          tags: 'ams',
        },
        options: {
          ignoreHtmlClass: 'mathjax_ignore',
        }
      };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
</head>
<body>
    {% include "nav.html" %}
    <main>
        <header>
            <h1>{{ title }}</h1>
        </header>
        {{ content | safe }}
        {% include 'footer.html' %}  
    </main>
</body>
</html>

