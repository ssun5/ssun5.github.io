<!-- src/_includes/base.njk -->
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }}</title>
    <script src="https://kit.fontawesome.com/f94f6790a2.js" crossorigin="anonymous"></script>
	<link href="{{ '/output.css' | url }}" rel="stylesheet">
  <link
			href="{{ '/assets/css/prism-xonokai.css' | url }}"
			rel="stylesheet"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

    <!-- MathJax Client-Side Loader -->
    <script>
      MathJax = {
        tex: {
          packages: {'[+]': ['ams']},
          inlineMath: [['\\(', '\\)'], ['$', '$']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']],
          processEscapes: true,
          processEnvironments: true,
          tags: 'ams',
        },
        options: {
          ignoreHtmlClass: 'mathjax_ignore',
        }
      };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
    <script>
      // Force reference highlight animation to restart on each click
      function restartHighlightAnimation(hash) {
        if (!hash) return;
        const target = document.querySelector(hash);
        if (target && target.matches('ol.references li')) {
          // Remove and re-add animation to force restart
          target.style.animation = 'none';
          // Force reflow
          void target.offsetHeight;
          // Re-apply animation
          target.style.animation = 'highlight-fade 3s ease-out forwards';
        }
      }
      
      document.addEventListener('DOMContentLoaded', () => {
        // Listen for hash changes (when clicking reference links)
        window.addEventListener('hashchange', () => {
          restartHighlightAnimation(window.location.hash);
        });
        
        // Listen for clicks on reference links to handle same-link clicks
        document.addEventListener('click', (e) => {
          const link = e.target.closest('a[href^="#ref"]');
          if (link) {
            const hash = link.getAttribute('href');
            // Small delay to let the hash change first
            setTimeout(() => {
              restartHighlightAnimation(hash);
            }, 10);
          }
        });
        
        // Also handle initial page load with hash
        if (window.location.hash) {
          setTimeout(() => {
            restartHighlightAnimation(window.location.hash);
          }, 100);
        }
      });
    </script>
</head>
<body>
    {%- if nav == False -%}
    {%- include "nav.html" -%}
    {%- endif -%}
    <main>
        <header>
            {%- if date -%}
            <p class="text-xs my-0">{{ date | date("MMM DD, YYYY") }}</p>
            {%- endif -%}
        </header>
        {{ content | safe }}
        {% include 'footer.html' %}  
    </main>
    <div
        id="image-modal"
        class="image-modal"
        hidden
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-label="Enlarged image"
    >
        <button type="button" class="image-modal__close" aria-label="Close">&times;</button>
        <img class="image-modal__img" alt="" decoding="async" />
    </div>
    <script defer src="{{ '/assets/js/image-modal.js' | url }}"></script>
</body>
</html>

